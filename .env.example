AWS_REGION=us-east-1
# En produccion usa un rol de IAM; estas claves son solo para desarrollo local
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_BUCKET_NAME=your-transcribe-audio-bucket

# Agente de Amazon Bedrock
BEDROCK_AGENT_ID=your_agent_id_here
BEDROCK_AGENT_ALIAS_ID=your_agent_alias_id_here
